# Exemplo de Configuração de Ambiente — Assistente WIN Profit
# Nenhuma chave de API ou credencial real deve ser commitada neste arquivo.

# Símbolo do Contrato Vigente do Mini-Índice
DEFAULT_SYMBOL=WINZ26

# Modo de Execução do Harness (COPILOT | FULL_AUTO)
# O modo padrão OBRIGATÓRIO de segurança é COPILOT (apenas alertas consultivos)
EXECUTION_MODE=COPILOT

# Caminhos de Estado Compartilhado
RUNTIME_STATE_PATH=data/runtime_state.json
NIVEIS_60M_PATH=data/niveis_60m.json
STATE_MACHINE_SESSION_PATH=data/state_machine_session.json

# Governança de Risco
MAX_DAILY_STOPS=2
STOP_POINTS=250.0
TARGET_POINTS=400.0
DEFAULT_CONTRACTS=5
